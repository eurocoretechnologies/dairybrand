# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). Optional for a first run: without
# them the site builds and shows placeholder content.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row-level security; used to insert orders.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used for metadata and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Palette used when the settings.palette row is missing.
# One of: peacock-brass, pasture-ghee, indigo-saffron, terracotta-malai, midnight-malai, kesar-pista
DEFAULT_PALETTE=peacock-brass

# "true" shows the palette picker and enables ?palette=… (preview deploys only).
NEXT_PUBLIC_ALLOW_PALETTE_PREVIEW=true

# Local development only: "true" shows sample products, banners and reviews
# when Supabase is not configured. Ignored once Supabase is connected.
DEMO_CONTENT=false

# Shared secret for POST /api/revalidate (e.g. from a Supabase webhook).
REVALIDATE_SECRET=
